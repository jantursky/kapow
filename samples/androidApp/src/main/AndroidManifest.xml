<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Haptics switch in the gallery's settings plays effects' feedback on the vibrator. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Kapow gallery"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gallery">
        <!--
            Optional extras open a page directly, which scripts/device-smoke.sh uses:
            entry (string, a catalog id such as change-glitch) and dark (boolean).
        -->
        <activity
            android:name="com.jantursky.kapow.samples.android.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
